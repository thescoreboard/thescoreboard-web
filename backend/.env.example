# ── Environment ───────────────────────────────────
ENV=dev

# ── Database ──────────────────────────────────────
# Use your dev Supabase project's connection string locally.
# Never commit a real password here — this file is a tracked template.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# ── CORS ──────────────────────────────────────────
# Dev: http://localhost:5173
# Prod: https://thescoreboard.com (or your Render URL)
FRONTEND_URL=http://localhost:5173

# ── Public URLs ──────────────────────────────────
# APP_URL  = the backend's own public URL (used for OG image absolute URLs)
# SITE_URL = the frontend's public URL (used for redirect targets in share pages)
APP_URL=https://api.thescoreboard.in
SITE_URL=https://thescoreboard.in

# ── Supabase Storage (for posters/banners) ────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
